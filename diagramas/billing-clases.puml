@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classBackgroundColor #EEF4FB
skinparam classBorderColor #24527A
hide empty members

title Subscription & Billing - Domain Layer (propuesta)

class Company <<Aggregate Root>> {
  {field} -id: uuid
  {field} -name: varchar(150)
  {field} -active: boolean
  +deactivate(): void
}
class SubscriptionPlan <<Aggregate Root>> {
  {field} -id: uuid
  {field} -name: varchar(60)
  {field} -asset_limit: integer
  {field} -amount: numeric(12,2)
  {field} -currency: char(3)
  +changeLimit(limit: int): void
}
class Subscription <<Aggregate Root>> {
  {field} -id: uuid
  {field} -tenant_id: uuid
  {field} -plan_id: uuid
  {field} -asset_limit: integer
  {field} -status: varchar(20)
  {field} -starts_at: timestamptz
  {field} -ends_at: timestamptz
  +isActive(at: DateTime): boolean
  +suspend(): void
  +cancel(): void
}
class CapacityReservation <<Entity>> {
  {field} -id: uuid
  {field} -tenant_id: uuid
  {field} -subscription_id: uuid
  {field} -operation_id: uuid
  {field} -asset_id: uuid
  {field} -status: varchar(20)
  {field} -created_at: timestamptz
  +confirm(): void
  +release(): void
}
class Invoice <<Aggregate Root>> {
  {field} -id: uuid
  {field} -tenant_id: uuid
  {field} -subscription_id: uuid
  {field} -number: varchar(50)
  {field} -amount: numeric(12,2)
  {field} -currency: char(3)
  {field} -status: varchar(20)
  {field} -issued_at: timestamptz
  {field} -payment_reference: varchar(120) [0..1]
  +markPaid(reference: string): void
  +void(): void
}
class Money <<Value Object>> {
  {field} -amount: decimal
  {field} -currency: string
  +of(amount, currency): Money
}
Company "1" --> "0..1" Subscription : contrata
SubscriptionPlan "1" --> "0..*" Subscription : define oferta
Subscription "1" *--> "0..*" CapacityReservation : contiene
Subscription "1" --> "0..*" Invoice : genera
Invoice ..> Money : utiliza
interface IBillingRepository {
  +findById(tenantId: UUID, id: UUID): Aggregate
  +save(aggregate: Aggregate): void
}
IBillingRepository ..> Company : recupera / persiste
@enduml