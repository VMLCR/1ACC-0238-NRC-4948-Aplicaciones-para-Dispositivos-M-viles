    rectangle "==Application Handlers\n<size:16>[Component: TypeScript]</size>\n\nRegisterCompanyHandler, ChangeSubscriptionPlanHandler, CheckSubscriptionExpiryHandler, CreateSubscriptionHandler, ReserveCapacityHandler, ConfirmCapacityHandler, ReleaseCapacityHandler, IssueInvoiceHandler" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as PredictiveMaintain.SubscriptionBillingAPI.ApplicationHandlers
    rectangle "==Domain Model\n<size:16>[Component: TypeScript]</size>\n\nCompany, SubscriptionPlan, Subscription, CapacityReservation, Invoice" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as PredictiveMaintain.SubscriptionBillingAPI.DomainModel
